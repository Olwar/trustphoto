# Set these in the server's environment (for example `node --env-file=.env apps/server/dist/index.js`,
# or your host's secrets). The server reads no .env file by itself. Development needs none of these.

NODE_ENV=production
PORT=8787
PUBLIC_BASE_URL=https://photos.example.com
# Address and port the server listens on.
HOST=0.0.0.0

# Postgres 14+ (production). Without it the server uses an embedded Postgres in DATA_DIR.
DATABASE_URL=postgres://user:password@host:5432/trustphoto
DATA_DIR=.data

# S3-compatible bucket, e.g. Cloudflare R2 (production). Without it photos go to DATA_DIR/media.
# On Fly.io, `fly storage create` sets AWS_ENDPOINT_URL_S3, BUCKET_NAME, AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY on the app; the server reads those names too.
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=trustphoto-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Region of the bucket. Not set: "auto" (right for R2).
S3_REGION=
# true for MinIO and most self-hosted S3 servers (path-style URLs); R2 and AWS need false.
S3_FORCE_PATH_STYLE=false

# Ed25519 private key, PKCS#8 PEM, on one line with \n escapes (as .env files and docker --env-file need):
#   node -e "console.log(JSON.stringify(require('crypto').generateKeyPairSync('ed25519').privateKey.export({ type: 'pkcs8', format: 'pem' })).slice(1, -1))"
TRUSTPHOTO_SIGNING_KEY=
# After a key change: a JSON array of the old public keys (PEM), so older receipts still check.
TRUSTPHOTO_RETIRED_PUBLIC_KEYS=[]
# 32+ random characters: signs the short-lived URL the vision model fetches, seals the lookup tokens of
# "Check a photo", and keys the hashes of reporter and client addresses. Keep it stable across restarts.
URL_SECRET=

# iOS App Attest: <TeamID>.<bundle id>
APP_ATTEST_APP_ID=TEAMID.com.socialhuman.trustphoto
# Development only: accept keys from Apple's development App Attest environment (the app's entitlement is production).
APP_ATTEST_DEVELOPMENT=false
# Android Play Integrity
PLAY_INTEGRITY_PACKAGE_NAME=com.socialhuman.trustphoto
# The Google service-account key JSON, on one line (it can decode Play Integrity tokens only).
PLAY_INTEGRITY_SA_JSON=

# The photo checks (docs/PHOTO-CHECKS.md).
# Not set: the module in apps/server/private/photo-checks/ when that folder exists, else the reference checks.
# "reference": the example checks in apps/server/src/checks/reference.ts.
# A path or a package name: your own module.
# (A relative path starts at the folder the server runs in; an absolute path is safest.)
PHOTO_CHECKS_MODULE=
# Production refuses the reference checks (a careful fake passes them), unless PHOTO_CHECKS_MODULE=reference
# and this is true.
ALLOW_REFERENCE_CHECKS=false
# The optional vision check of the reference checks: an OpenAI-compatible chat completions URL.
# It gets a metadata-free copy of each photo that would pass. Off when the URL or the key is empty.
# When it is on and gives no answer, the photo does not verify and the phone may try again.
VISION_CHECK_URL=
VISION_CHECK_API_KEY=
VISION_CHECK_MODEL=gpt-4o-mini
# Milliseconds to wait for an answer.
VISION_CHECK_TIMEOUT_MS=8000
# How the privacy page names the company behind VISION_CHECK_URL, e.g. "Example AI, in the EU".
VISION_CHECK_PROVIDER=

# Header your proxy sets to the client address (and overwrites if a client sends it).
# Fly: fly-client-ip. Cloudflare: cf-connecting-ip. Required in production.
CLIENT_IP_HEADER=fly-client-ip
# Verifications at once per instance (each decodes a full photo).
VERIFY_CONCURRENCY=2
# Uploads received or checked at once per instance (each holds up to 15 MB).
MAX_UPLOADS_IN_FLIGHT=16

# Development only
REQUIRE_ATTESTATION=false
ALLOW_EMULATOR=false

# Shown on the privacy page. Required in production.
OPERATOR_NAME=
CONTACT_EMAIL=
# Google calls a day for all installs that never passed the device check together.
# Keep well below your Play Integrity quota (Google's default is 10,000 a day).
UNPROVEN_DAILY_GOOGLE_CALLS=3000

# Website store buttons (shown when set)
APP_STORE_URL=
PLAY_STORE_URL=
